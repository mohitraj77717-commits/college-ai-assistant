# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
PORT=5000
SECRET_KEY=replace_with_a_secure_random_secret_key_in_production

# Database Configuration (Relative to backend folder)
DATABASE_NAME=college.db

# Administrator Bootstrap Token (Used during secure one-time initial admin setup)
ADMIN_SETUP_KEY=university_bootstrap_admin_key_2026

# Google Gemini API Key
# 1. Obtain an API key from Google AI Studio: https://aistudio.google.com/
# 2. Copy this file to '.env' inside the backend/ folder: cp .env.example .env
# 3. Replace 'your_api_key_here' with your actual key below
GEMINI_API_KEY=your_api_key_here

# File Upload Settings
MAX_CONTENT_LENGTH=16777216  # 16 MB maximum upload limit
UPLOAD_FOLDER=uploads
